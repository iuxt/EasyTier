# Only send Rust workspace inputs. In particular, exclude local config/secrets,
# .git, target output, and unrelated build artifacts.
**
!Cargo.toml
!Cargo.lock
!LICENSE
!rust-toolchain.toml
!.cargo/
!.cargo/config.toml
!easytier/
!easytier/**
!easytier-core/
!easytier-core/**
!easytier-proto/
!easytier-proto/**
!vendor/
!vendor/**
**/target
**/node_modules
**/dist
**/.git
**/.env
**/.env.*
**/.DS_Store
