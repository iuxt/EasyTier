# Copy to .env for Docker Compose; see docs/deployment.md.
# Replace all four values with distinct random secrets (openssl rand -hex 32).
# Do not commit .env. MySQL passwords here initialize a NEW data volume only.
MYSQL_PASSWORD=replace-with-random-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-different-root-password
ADMIN_PASSWORD=replace-with-admin-password-at-least-24-characters
ENROLLMENT_TOKEN=replace-with-enrollment-token-at-least-24-characters
# Use false only for local HTTP development. Production HTTPS must use true.
COOKIE_SECURE=true
LOG_RETENTION_DAYS=7
# Compose image tag; build.sh uses an exported IMAGE variable or IMAGE=... prefix.
IMAGE=iuxt/easytier-server:latest
# Host port and bind address; container always listens on 0.0.0.0:8080.
# Keep loopback when a reverse proxy runs on the host.
HOST_BIND=127.0.0.1
HTTP_PORT=8080
